{
  "name": "instant-split",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx concurrently \"npm run dev --workspace=client\" \"npm run start dev --workspace=server\"",
    "trace": "npx concurrently \"npm run dev --workspace=client\" \"LOG_API_REQUESTS=true npm run start dev --workspace=server\"",
    "start:client": "npm run dev --workspace=client",
    "start:server": "npm run start --workspace=server",
    "test": "npm test --workspaces --if-present",
    "test:client": "npm test --workspace=client",
    "test:server": "npm test --workspace=server",
    "tree": "npx tree-node-cli -I 'node_modules|.git' > docs/repository-structure.md",
    "clean:install": "rm -rf node_modules package-lock.json client/node_modules client/package-lock.json server/node_modules server/package-lock.json && npm install && npm audit"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-helmet-async": {
      "react": "^19.0.0",
      "react-dom": "^19.0.0"
    },
    "eslint": "^9.10.0",
    "eslint-config-airbnb": {
      "eslint": "^9.10.0"
    },
    "eslint-plugin-import": {
      "eslint": "^9.10.0"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "^9.10.0"
    },
    "eslint-plugin-react": {
      "eslint": "^9.10.0"
    }
  }
}
